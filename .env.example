# Sao chép file này thành .env rồi sửa giá trị (file .env không đưa lên GitHub).

# IP tĩnh của xe — phải khớp STATIC_IP trong firmware/esp32cam_car/config.h
ESP32_IP=192.168.43.50

# Nguồn camera. Để trống = tự lấy http://<ESP32_IP>:81/stream
#   0            webcam laptop (dự phòng khi xe lỗi)
#   video.mp4    file video, phát lặp (để test không cần xe)
CAMERA_SOURCE=

# Model của nhóm (0 = pothole, 1 = speed_bump). Chưa có file thì server dùng
# 2 model mẫu trong models/sample/.
MODEL_PATH=models/road_best.pt
CONFIDENCE=0.5
IMG_SIZE=416

# Chống báo giả: phải thấy liên tiếp bao nhiêu khung mới cảnh báo,
# và bao nhiêu giây sau mới báo lại cùng một loại.
CONFIRM_FRAMES=2
ALERT_COOLDOWN=2.0

# Bỏ qua khung camera bị che hoặc quá tối (ảnh xám, thang 0–255):
# độ sáng trung bình dưới MIN_BRIGHTNESS hoặc độ tương phản dưới MIN_CONTRAST.
MIN_BRIGHTNESS=40
MIN_CONTRAST=15

# Telegram (để trống = tắt)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
